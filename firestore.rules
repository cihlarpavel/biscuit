rules_version = '2';
// Pravidla pro Biscuit. Vložit do Firebase konzole: Firestore Database -> Rules -> Publish.
// Každé zařízení je anonymně přihlášené (uid). Profil (hraci) patří zařízení, které ho založilo.
// Seznamy profilů a kódů nejdou vypsat – kamarádku najdeš jen podle kódu, který ti dá osobně.
service cloud.firestore {
  match /databases/{db}/documents {
    function prihlasen() { return request.auth != null; }
    function vlastnikHrace(id) { return get(/databases/$(db)/documents/hraci/$(id)).data.owner == request.auth.uid; }

    match /hraci/{id} {
      allow get: if prihlasen();
      allow list: if false;
      allow create: if prihlasen() && request.resource.data.owner == request.auth.uid
                    && request.resource.data.prezdivka is string && request.resource.data.prezdivka.size() <= 20;
      allow update: if prihlasen() && resource.data.owner == request.auth.uid
                    && request.resource.data.owner == request.auth.uid
                    && request.resource.data.prezdivka is string && request.resource.data.prezdivka.size() <= 20;
      allow delete: if prihlasen() && resource.data.owner == request.auth.uid;
    }

    match /kody/{kod} {
      allow get: if prihlasen();
      allow list: if false;
      allow create: if prihlasen() && kod.size() == 6 && vlastnikHrace(request.resource.data.hrac);
      allow delete: if prihlasen() && vlastnikHrace(resource.data.hrac);
    }

    match /pratelstvi/{id} {
      allow read: if prihlasen() && request.auth.uid in resource.data.vlastnici;
      allow create: if prihlasen() && request.auth.uid in request.resource.data.vlastnici
                    && request.resource.data.clenove.size() == 2 && request.resource.data.vlastnici.size() == 2;
      allow delete: if prihlasen() && request.auth.uid in resource.data.vlastnici;
    }

    match /battly/{id} {
      allow read: if prihlasen() && request.auth.uid in resource.data.vlastnici;
      allow create: if prihlasen() && request.resource.data.vlastnici[0] == request.auth.uid
                    && vlastnikHrace(request.resource.data.hraci[0])
                    && request.resource.data.hlaska is int;
      allow update: if prihlasen() && request.auth.uid in resource.data.vlastnici
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vysledky', 'stav']);
    }
  }
}
